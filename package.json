{
  "name": "dsh-wpac",
  "version": "0.8.4",
  "private": true,
  "type": "module",
  "description": "WPAC agent preset: W(我是) / P(要什么) / A(给谁) / C(约束) prompt engineering for DSH. Author: 姜涛.",
  "author": "姜涛",
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "agent-preset",
    "prompt-engineering",
    "wpac",
    "姜涛"
  ],
  "files": [
    "persona.md",
    "lib",
    "cordis.patch.yml",
    "skills",
    "templates",
    "scripts",
    "tests",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    ".gitignore"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/bigfatdsh/dsh-wpac.git"
  },
  "homepage": "https://github.com/bigfatdsh/dsh-wpac",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./inject": "./lib/inject6.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./tools": "./lib/tools.js"
  }
}
